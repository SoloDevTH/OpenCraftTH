<!--
  WixStdBA's HyperlinkTheme.xml (WiX v5.0.2, src/ext/Bal/stdbas/Resources) with the licence and
  options controls replaced by a checkbox per app, each with a line on what it does in English and Thai. A named checkbox sets the Burn variable of the
  same name (Install_<app>: opencraft.wxs); Has_<app> hides the box for an app this build left out.
  The Modify page's "Change" goes back to that page, whose Install then adds and removes apps.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="1" Height="-24" Weight="500" Foreground="windowtext">Segoe UI</Font>
    <Font Id="2" Height="-22" Weight="500" Foreground="graytext">Segoe UI</Font>
    <Font Id="3" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <!-- The app list: name, then what it does in English and in Thai (Leelawadee UI ships with Windows 10+). -->
    <Font Id="4" Height="-13" Weight="700" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="5" Height="-12" Weight="400" Foreground="graytext" Background="window">Segoe UI</Font>
    <Font Id="6" Height="-12" Weight="400" Foreground="graytext" Background="window">Leelawadee UI</Font>

    <Window Width="650" Height="480" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)">
        <ImageControl X="11" Y="11" Width="64" Height="64" ImageFile="logo.png" Visible="yes"/>
        <Label X="80" Y="11" Width="-11" Height="64" FontId="1" Visible="yes" DisablePrefix="yes">#(loc.Title)</Label>

        <Page Name="Help">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="11" Y="112" Width="-11" Height="-35" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Loading">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>
        <Page Name="Install">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>Choose the programs to install · เลือกโปรแกรมที่จะติดตั้ง</Text>
                <Text Condition="WixBundleInstalled">Choose the programs to keep · เลือกโปรแกรมที่จะเก็บไว้</Text>
            </Label>
            <Label X="11" Y="110" Width="-11" Height="17" FontId="3" DisablePrefix="yes">
                <Text>Each one gets a Start menu entry and is offered under "Open with" for its file types.</Text>
                <Text Condition="WixBundleInstalled">Tick a program to add it, untick it to remove it.</Text>
            </Label>

            <Checkbox Name="Install_cadcraft" X="11" Y="136" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_cadcraft">CADCraft</Checkbox>
            <Label X="28" Y="155" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_cadcraft">CAD drafting; opens DXF and DWG drawings.</Label>
            <Label X="28" Y="171" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_cadcraft">เขียนแบบ CAD เปิดไฟล์แบบ DXF และ DWG</Label>
            <Checkbox Name="Install_designcraft" X="11" Y="194" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_designcraft">DesignCraft</Checkbox>
            <Label X="28" Y="213" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_designcraft">Page layout for books, magazines and posters.</Label>
            <Label X="28" Y="229" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_designcraft">จัดหน้าหนังสือ นิตยสาร และโปสเตอร์</Label>
            <Checkbox Name="Install_effectcraft" X="11" Y="252" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_effectcraft">EffectCraft</Checkbox>
            <Label X="28" Y="271" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_effectcraft">Animated titles, motion graphics, compositing.</Label>
            <Label X="28" Y="287" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_effectcraft">ไตเติลเคลื่อนไหว โมชันกราฟิก และงานคอมโพสิต</Label>
            <Checkbox Name="Install_filmcraft" X="11" Y="310" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_filmcraft">FilmCraft</Checkbox>
            <Label X="28" Y="329" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_filmcraft">Video editing: multi-track timeline, colour, audio.</Label>
            <Label X="28" Y="345" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_filmcraft">ตัดต่อวิดีโอ ไทม์ไลน์หลายแทร็ก ปรับสี และเสียง</Label>
            <Checkbox Name="Install_gridcraft" X="11" Y="368" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_gridcraft">GridCraft</Checkbox>
            <Label X="28" Y="387" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_gridcraft">Spreadsheets with formulas; opens Excel and CSV.</Label>
            <Label X="28" Y="403" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_gridcraft">ตารางคำนวณพร้อมสูตร เปิดไฟล์ Excel และ CSV</Label>
            <Checkbox Name="Install_lightcraft" X="330" Y="136" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_lightcraft">LightCraft</Checkbox>
            <Label X="347" Y="155" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_lightcraft">Photo library and RAW darkroom, non-destructive.</Label>
            <Label X="347" Y="171" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_lightcraft">คลังรูปและห้องมืดแต่งไฟล์ RAW ไม่ทำลายต้นฉบับ</Label>
            <Checkbox Name="Install_pdfcraft" X="330" Y="194" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_pdfcraft">PdfCraft</Checkbox>
            <Label X="347" Y="213" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_pdfcraft">Read, annotate, fill, sign and OCR PDF files.</Label>
            <Label X="347" Y="229" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_pdfcraft">อ่าน ใส่หมายเหตุ กรอกฟอร์ม เซ็น และ OCR ไฟล์ PDF</Label>
            <Checkbox Name="Install_photocraft" X="330" Y="252" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_photocraft">PhotoCraft</Checkbox>
            <Label X="347" Y="271" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_photocraft">Layered image editing; opens Photoshop PSD.</Label>
            <Label X="347" Y="287" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_photocraft">แต่งภาพแบบเลเยอร์ เปิดไฟล์ PSD ของ Photoshop</Label>
            <Checkbox Name="Install_vectorcraft" X="330" Y="310" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_vectorcraft">VectorCraft</Checkbox>
            <Label X="347" Y="329" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_vectorcraft">Vector illustration; SVG, AI, EPS and PDF.</Label>
            <Label X="347" Y="345" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_vectorcraft">วาดภาพเวกเตอร์ รองรับ SVG, AI, EPS และ PDF</Label>
            <Checkbox Name="Install_wordcraft" X="330" Y="368" Width="300" Height="17" TabStop="yes" FontId="4" VisibleCondition="Has_wordcraft">WordCraft</Checkbox>
            <Label X="347" Y="387" Width="283" Height="16" FontId="5" DisablePrefix="yes" VisibleCondition="Has_wordcraft">Word processing; opens Word, ODT and RTF files.</Label>
            <Label X="347" Y="403" Width="283" Height="20" FontId="6" DisablePrefix="yes" VisibleCondition="Has_wordcraft">พิมพ์เอกสาร เปิดไฟล์ Word, ODT และ RTF</Label>

            <Button Name="InstallUpdateButton" X="11" Y="-11" Width="200" Height="23" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="InstallButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.InstallInstallButton)</Text>
                <Text Condition="WixBundleInstalled">&amp;Apply</Text>
            </Button>
            <Button Name="InstallCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Progress">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label X="11" Y="121" Width="70" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
            <Label Name="OverallProgressPackageText" X="85" Y="121" Width="-11" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="11" Y="143" Width="-11" Height="15" />
            <Button Name="ProgressCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>
        <Page Name="Modify">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Label X="11" Y="121" Width="-11" Height="34" FontId="3" DisablePrefix="yes">Change adds or removes programs. Repair reinstalls the installed ones; Uninstall removes them all.</Label>
            <Button Name="ModifyUpdateButton" X="11" Y="-11" Width="200" Height="23" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="ChangeButton" X="-251" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>&amp;Change</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="RepairButton" X="-171" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Success">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="-11" Y="-51" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
                <Text>#(loc.SuccessRestartText)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
            </Label>
            <Button Name="SuccessRestartButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Failure">
            <Label X="11" Y="80" Width="-11" Height="30" FontId="2" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.FailureUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.FailureCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="11" Y="121" Width="-11" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="22" Y="163" Width="-11" Height="51" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="-11" Y="-51" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-91" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-11" Y="-11" Width="75" Height="23" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
